---
import BaseLayout from '../layouts/BaseLayout.astro';
import { byUpdated, getNotes, getTagMap } from '../lib/notes';
import { tagUrl } from '../lib/tags.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const notes = (await getNotes()).sort(byUpdated);
const tagMap = await getTagMap();
const popularTags = [...tagMap.entries()].sort((a, b) => b[1].length - a[1].length).slice(0, 12);
---
<BaseLayout title="Brewnotes">
  <section class="hero">
    <h1>Brewnotes</h1>
    <p>ビールと醸造に関する知識や情報をまとめる場所。</p>
  </section>

  <section>
    <h2>最近の記事</h2>
    {notes.length > 0 ? (
      <ul class="note-list">
        {notes.slice(0, 10).map((note) => <li><a href={`${base}/${note.slug}/`}>{note.title}</a></li>)}
      </ul>
    ) : <p class="muted">記事はまだありません。</p>}
  </section>

  {popularTags.length > 0 && (
    <section>
      <h2>よく使うタグ</h2>
      <div class="tag-cloud">
        {popularTags.map(([tag, taggedNotes]) => <a href={tagUrl(tag, base)}>#{tag} <small>{taggedNotes.length}</small></a>)}
      </div>
    </section>
  )}
</BaseLayout>
